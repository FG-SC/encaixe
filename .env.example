# Copy to .env (never committed). Real environment variables win over this file.

# Embeddings backend: onnx (default, local MiniLM model; "fastembed" is accepted as an alias) | tfidf (fallback) | fake (tests only)
EMBEDDINGS=onnx
EMBED_THREADS=2

# Optional LLM (Groq free tier). Without a key everything works with the heuristic extractor.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Where the database, model cache, snapshots and uploads live (default: ./var, gitignored)
# ENCAIXE_VAR_DIR=./var
LOG_LEVEL=INFO
