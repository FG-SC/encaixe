# Copy to .env.prod at the repository root on the server and fill in. Never commit .env.prod.
# ENCAIXE_ENV=prod and ENCAIXE_VAR_DIR=/data are set by the Dockerfile.

# Public host name (DNS A record pointing to this server) and the matching address used in login e-mails.
DOMAIN=encaixe.example.com.br
BASE_URL=https://encaixe.example.com.br

# Login links go by e-mail (no passwords). Port 587 (STARTTLS) or 465 (SSL); some clouds block 25 and 465.
SMTP_HOST=smtp-relay.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Encaixe <login@encaixe.example.com.br>

# Optional: invite-only beta (comma-separated e-mails). Empty = open sign-up.
ALLOWED_EMAILS=

# Optional LLM (Groq free tier): CV reading only with the person's consent. Empty = heuristic extraction only.
GROQ_API_KEY=

# The source code offered to users (AGPL-3.0, site footer and rules page).
ENCAIXE_SOURCE_URL=https://github.com/FG-SC/encaixe

LOG_LEVEL=INFO
